        </mxCell>
        <mxCell id="272" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="Triton Gumbel-Max，内存更省" vertex="1">
