        </mxCell>
        <mxCell id="185" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=10;" value="R1 decode +1tok  R2 +1tok&#xa;R3: +2 blocks  R4: +1 block" vertex="1">
